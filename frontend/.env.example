# Frontend — public API base (browser-safe)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Optional server-side mirror for RSC fetches (same host as NEXT_PUBLIC_API_URL)
API_URL=http://127.0.0.1:8000/api/v1

# Auth.js / NextAuth — server-side only (never NEXT_PUBLIC_*)
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3001
AUTH_TRUST_HOST=true

# Static catalog fallback when Django is unreachable.
# Development: defaults ON (NODE_ENV !== production).
# Production: defaults OFF — set true only for emergency content display demos.
# Checkout always goes through Django; never trust static prices for orders.
# NEXT_PUBLIC_ALLOW_STATIC_CATALOG_FALLBACK=false

# --- Production example ---
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
# API_URL=https://api.example.com/api/v1
# AUTH_URL=https://www.example.com
# AUTH_SECRET=<openssl rand -base64 32>
# NEXT_PUBLIC_ALLOW_STATIC_CATALOG_FALLBACK=false
