# PostgreSQL
DATABASE_URL="postgresql://USER@localhost:5432/mmh_development"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3001"
AUTH_TRUST_HOST="true"

# AES-256-GCM key for digital codes — 64 hex chars
# openssl rand -hex 32
CODE_ENCRYPTION_KEY=""

# Bootstrap SUPER_ADMIN created by `npx prisma db seed`
# Do not commit real values. Password must be at least 12 characters
# and include upper, lower, number, and symbol.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Media
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="storage/uploads"
# Production S3-compatible placeholder
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Supplier — keep MOCK for storefront auto-fulfillment. 1Epin test client is used when credentials exist.
SUPPLIER_MODE="mock"
ONEEPIN_MODE=test
ONEEPIN_TEST_BASE_URL=https://www.1epin.com/api/test/
ONEEPIN_LIVE_BASE_URL=https://www.1epin.com/api/live/
ONEEPIN_EMAIL=
ONEEPIN_PASSWORD=
ONEEPIN_CALLBACK_TOKEN=
ONEEPIN_RECONCILE_TOKEN=
ONEEPIN_REQUEST_TIMEOUT_MS=15000
ONEEPIN_ALLOW_LIVE=false
ONEEPIN_SYNC_ENABLED=false
# Do not store supplier passwords in the database.
